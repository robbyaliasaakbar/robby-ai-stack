# Hey, this is just an example file
# Copy this file to .env and fill in your own values
# This file is safe to share because it has no real secrets inside

# Needed for file browser in Open Terminal
# Just make up your own long random string and paste it here
OPEN_TERMINAL_API_KEY=change_me_to_your_own_key

# Needed for Scrapling MCP auth
# Just make up your own long random token and use the same one in your client
SCRAPLING_MCP_AUTH_TOKEN=change_me_to_your_own_token

# Needed for Hostinger MCP
# Get it from your Hostinger panel and paste it here
HOSTINGER_API_TOKEN=change_me_to_your_own_token
